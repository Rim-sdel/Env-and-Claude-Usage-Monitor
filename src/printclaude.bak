// =============================================
//  メイン画面（案A + アイコン + リセットカウントダウン）
// =============================================

void drawPct(int x, int y, int pct, const uint8_t *mainFont, const uint8_t *smallFont) {
  char numBuf[6];
  snprintf(numBuf, sizeof(numBuf), "%d", pct);
  u8g2.setFont(mainFont);
  u8g2.drawStr(x, y, numBuf);
  int w = u8g2.getStrWidth(numBuf);
  u8g2.setFont(smallFont);
  u8g2.drawStr(x + w + 1, y, "%");
}

void drawClaude() {
  u8g2.clearBuffer();

  // ---- カニ 24x24（左、垂直中央寄り） ----
  u8g2.drawXBM(2, 22, 24, 24, crab_24x24); // 2, 8, 24, 24

  // ---- 縦線セパレータ（カニの右端 x=26 の外側） ----
  // u8g2.drawVLine(28, 4, 56);

  // ---- 5時間セッション ----
  u8g2.drawXBM(barAreaL, 8, 7, 7, icon_clock);

  if (fiveHourPct >= 0) {
    drawPct(numX, 22, fiveHourPct, cNUM, cNUMs);
    // char buf[8];
    // snprintf(buf, sizeof(buf), "%d%%", fiveHourPct);
    // u8g2.setFont(cNUM);          // NUM（環境モニターと同じ）
    // u8g2.drawStr(numX, 22, buf); // 39, 18, buf

    // プログレスバー: x=31, y=20, 幅90, 5
    u8g2.drawFrame(barAreaL, 24, barWidth, 5);
    if (fiveHourPct > 0) {
      int fill = (fiveHourPct * 88) / 100;
      u8g2.drawBox(barAreaL + 1, 25, fill, 3);
    }

    // リセット（バー右下）
    String r = remainStr(fiveHourReset);
    if (r.length() > 0) {
      u8g2.setFont(u8g2_font_4x6_tf); // HEAD_S
      int rw = u8g2.getStrWidth(r.c_str());
      u8g2.drawStr(121 - rw, 34, r.c_str()); // 121 - rw, 30
    }
  } else {
    u8g2.setFont(ui.HEAD); // HEAD（環境モニターと統一）
    u8g2.drawStr(39, 18, "N/A");
  }

  // ---- 7日制限 ----
  u8g2.drawXBM(barAreaL, 35, 7, 7, icon_cal); // 31, 33, 7, 7,

  if (sevenDayPct >= 0) {
    drawPct(numX, 50, sevenDayPct, cNUM, cNUMs);
    // char buf[8];
    // snprintf(buf, sizeof(buf), "%d%%", sevenDayPct);
    // u8g2.setFont(cNUM);          // NUM
    // u8g2.drawStr(numX, 50, buf); // 39, 48, buf

    u8g2.drawFrame(barAreaL, 52, barWidth, 5); // 31, 50 , 90, 5
    if (sevenDayPct > 0) {
      int fill = (sevenDayPct * 88) / 100;
      u8g2.drawBox(barAreaL + 1, 53, fill, 3); // 32, 51 , fill, 3
    }

    String r = remainStr(sevenDayReset);
    if (r.length() > 0) {
      u8g2.setFont(u8g2_font_4x6_tf); // HEAD_S
      int rw = u8g2.getStrWidth(r.c_str());
      u8g2.drawStr(121 - rw, 62, r.c_str()); // 121 -rw, 60,
    }
  } else {
    u8g2.setFont(ui.HEAD); // HEAD
    u8g2.drawStr(39, 48, "N/A");
  }

  u8g2.sendBuffer();
}

// プログレスバーを描く
void drawBar(int x, int y, int w, int h, int pct) {
  u8g2.drawFrame(x, y, w, h);
  if (pct > 0) {
    int fill = (pct * (w - 2)) / 100;
    u8g2.drawBox(x + 1, y + 1, fill, h - 2);
  }
}
