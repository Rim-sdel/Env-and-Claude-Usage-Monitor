// 時計アイコン 5x5 (8bit幅にパディング)
static const unsigned char PROGMEM icon_clock[] = {
  // 0x0E, // .###.
  // 0x15, // #.#.#
  // 0x1D, // #.###
  // 0x11, // #...#
  // 0x0E, // .###.
  0x1C, // row 0: ..███..
  0x2A, // row 1: .█.█.█.
  0x49, // row 2: █..█..█
  0x59, // row 3: █..██.█
  0x41, // row 4: █.....█
  0x22, // row 5: .█...█.
  0x1C, // row 6: ..███..
};

